# Avicon Travel — static PHP site
Options -Indexes
DirectoryIndex index.php index.html

# custom 404
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # never serve dot-folders like .git (Git deploys) — except .well-known (SSL validation)
  RewriteRule "(^|/)\.(?!well-known/)" - [F,L]
  # build tools live in _dev/ (never deployed, blocked in case a copy ever lands here)
  RewriteRule ^_dev(/|$) - [F,L]

  # one canonical origin: https://avicontravel.com (live domain only, so preview/staging hosts keep working)
  RewriteCond %{HTTP_HOST} ^(www\.)?avicontravel\.com$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://avicontravel.com%{REQUEST_URI} [L,R=301,NE]

  # old WordPress asset URLs (indexed images, backlinks) -> /assets/
  RewriteRule ^wp-content/uploads/(.*)$ /assets/uploads/$1 [L,R=301]
  RewriteRule ^wp-content/(plugins|themes)/(.*)$ /assets/$1/$2 [L,R=301]
  RewriteRule ^wp-includes/(.*)$ /assets/core/$1 [L,R=301]

  # old WordPress search (/?s=...) -> static search page (query string is kept)
  RewriteCond %{QUERY_STRING} (^|&)s= [NC]
  RewriteRule ^$ /search/ [L,R=301]

  # WordPress archives that no longer exist
  RewriteRule ^(.*/)?feed/?$ /blog/ [L,R=301]
  RewriteRule ^(category|tag|author)/ /blog/ [L,R=301]
  RewriteRule ^[0-9]{4}/([0-9]{2}/)?$ /blog/ [L,R=301]
  RewriteRule ^tour/?$ /packages/ [L,R=301]
  RewriteRule ^destination(/.*)?$ /packages/ [L,R=301]
  RewriteRule ^travel-agency-03/?$ / [L,R=301]

  # theme demo + shop content that was public on the old WordPress site -> 410 Gone
  RewriteRule ^(product|visa|experience|hotel)(/.*)?$ - [G,L]
  RewriteRule ^(shop|cart|checkout|my-account)/?$ - [G,L]
</IfModule>

# protect shared includes
<FilesMatch "^(header|footer|footer-avf|footer-cta|footer-form|wa-button|tracking)\.php$">
  Require all denied
</FilesMatch>

# dotfiles and source/config leftovers are never public
<FilesMatch "(^\.|\.(sql|log|lock|ya?ml|sh|dist|md|po|pot|mo|scss|ts|twig|vue|wie|dat)$)">
  Require all denied
</FilesMatch>

# security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json image/svg+xml text/xml application/xml
</IfModule>

# caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/gif "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>
